#!/usr/bin/env bash
# financial-chart from the shell: chart specs as JSON in, charts or JSON out.
#   financial-chart render spec.json        (or: ... | financial-chart render -)
#   financial-chart explain|validate spec.json
#   financial-chart example KIND | kinds | describe | doctor
# Set EMACS to pick the binary, EAS to pick the eas.el checkout (default: ../../Personal/emacs/eas.el). See src/cli/financial-chart-batch.el for the spec format.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
eas="${EAS:-$here/../../Personal/emacs/eas.el}"
exec "${EMACS:-emacs}" -Q --batch -L "$here/src" -L "$eas/src" -L "$here/src/cli" -l financial-chart-batch \
  -f financial-chart-batch-main "$@"
