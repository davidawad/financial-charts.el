{
  "cases": [
    {
      "name": "two-asset-total-absolute-allocation-drift",
      "metric": "port.drift",
      "input": {
        "allocations": [
          { "asset": "equity", "current_weight": 0.6, "target_weight": 0.5 },
          { "asset": "bonds", "current_weight": 0.4, "target_weight": 0.5 }
        ]
      },
      "expect": { "/value": 0.2 }
    },
    {
      "name": "weighted-scenario-return",
      "metric": "port.stress",
      "input": {
        "exposures": [
          { "asset": "equity", "weight": 0.6, "scenario_return": -0.25 },
          { "asset": "bonds", "weight": 0.4, "scenario_return": 0.05 }
        ]
      },
      "expect": { "/value": -0.13 }
    },
    {
      "name": "signed-beta-scaled-dollar-delta",
      "metric": "port.beta_weighted_delta",
      "input": {
        "positions": [
          { "asset": "long-call", "quantity": 10.0, "multiplier": 100.0, "delta": 0.5, "underlying_price": 200.0, "beta": 1.2 },
          { "asset": "short-put", "quantity": -2.0, "multiplier": 100.0, "delta": -0.4, "underlying_price": 150.0, "beta": 0.8 }
        ]
      },
      "expect": { "/value": 129600.0 }
    }
  ]
}
