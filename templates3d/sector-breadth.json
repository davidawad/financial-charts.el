{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "sector-breadth",
    "version": "1.0.0",
    "readout": {
      "max_lines": 1,
      "component": "row",
      "children": [
        {
          "component": "text",
          "props": {
            "text": {
              "expr": "at"
            },
            "priority": 10,
            "style": {
              "dim": true
            }
          }
        },
        {
          "component": "row",
          "children": [
            {
              "component": "text",
              "props": {
                "text": {
                  "expr": "datum.sector"
                },
                "priority": 95
              }
            },
            {
              "component": "text",
              "props": {
                "text": {
                  "expr": "datum.date"
                },
                "priority": 90
              }
            },
            {
              "component": "quantity",
              "props": {
                "field": "pct",
                "priority": 85,
                "label": "above MA",
                "format": "plain"
              }
            }
          ]
        }
      ]
    },
    "doc": "3D variant of financial-chart's sector-breadth (graphics.el, mark fc-breadth3d): breadth as a surface over sector (across) and date (toward the viewer), red to green, the 50% level framed, the newest date traced bright and the sectors' mean up the right wall; grows day by day.  2D: Market breadth by sector over time: the percent of each sector's members above their moving average, date across and sector down, red below half to green above.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {date, sector, pct}: pct 0-100 of the sector's members above their moving average (market.breadth_pct_above_200d), one per sector per date"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Market breadth by sector over time: the percent of each sector's members above their moving average, date across and sector down, red below half to green above.",
        "doc": "the takeaway; alt text and table-view fallback (bin/chart check requires it)"
      }
    },
    "example": "test/fixtures/3d/market/sector-breadth.data.json",
    "base": "sector-breadth",
    "graphics": {
      "mark": "fc-breadth3d",
      "encoding": {
        "x": {
          "field": "sector"
        },
        "z": {
          "field": "date"
        },
        "y": {
          "field": "pct"
        }
      },
      "replay": "date",
      "timeline": {
        "loop": true,
        "autoplay": true,
        "duration": 9
      },
      "camera": {
        "yaw": -65,
        "pitch": 40,
        "zoom": 1.2
      }
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": "container",
  "height": {
    "step": 16
  },
  "data": {
    "name": "data"
  },
  "layer": [
    {
      "name": "cells",
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "date",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelOverlap": true
          }
        },
        "y": {
          "field": "sector",
          "type": "nominal",
          "sort": null,
          "title": null
        },
        "color": {
          "field": "pct",
          "type": "quantitative",
          "title": "% above MA",
          "scale": {
            "scheme": "redyellowgreen",
            "domain": [
              0,
              100
            ],
            "domainMid": 50
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "nominal"
          },
          {
            "field": "sector",
            "type": "nominal"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
