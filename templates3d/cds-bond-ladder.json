{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "cds-bond-ladder",
    "version": "1.0.0",
    "doc": "3D variant of financial-chart's cds-bond-ladder (graphics.el, mark fc-cds-bond-ladder3d): CDS implied model yields as maturity bars with treasury yields as a ribbon, coloured by CDS spread extrapolation; model, not traded.  2D: CDS-implied corporate bond valuations; model, not traded.",
    "slots": {
      "data": {
        "shape": "invest/cds-bond-ladder",
        "required": true,
        "doc": "bond_corp.cds_implied_ladder output"
      },
      "title": {
        "type": "string",
        "default": "CDS implied bond ladder \u2014 model, not traded"
      },
      "description": {
        "type": "string",
        "default": "CDS implied model, not traded"
      },
      "measure": {
        "type": "string",
        "default": "model_yield",
        "enum": [
          "model_yield",
          "model_price",
          "cds_spread_bp",
          "expected_loss_per_100",
          "dv01_usd"
        ]
      }
    },
    "example": "test/fixtures/3d/rates/cds-bond-ladder.data.json",
    "base": "cds-bond-ladder",
    "graphics": {
      "mark": "fc-cds-bond-ladder3d",
      "encoding": {
        "x": {
          "field": "years"
        },
        "y": {
          "field": {
            "x-eas:slot": "measure"
          }
        },
        "z": {
          "field": "name"
        },
        "color": {
          "field": "spread_extrapolated"
        }
      },
      "ribbon": "treasury_yield",
      "extent": [
        14,
        10
      ],
      "height": 8,
      "camera": {
        "yaw": 24,
        "pitch": 24,
        "zoom": 1.3
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "description"
    }
  },
  "width": "container",
  "height": 240,
  "data": {
    "name": "data"
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "name",
      "type": "nominal",
      "sort": {
        "field": "years",
        "order": "ascending"
      },
      "title": "bond"
    },
    "y": {
      "field": {
        "x-eas:slot": "measure"
      },
      "type": "quantitative"
    },
    "color": {
      "field": "spread_extrapolated",
      "type": "nominal",
      "scale": {
        "domain": [
          "null",
          "below",
          "above"
        ],
        "range": [
          "#4c9f70",
          "#e6ab02",
          "#d95f59"
        ]
      }
    },
    "tooltip": [
      {
        "field": "name",
        "type": "nominal",
        "title": "bond"
      },
      {
        "field": "coupon",
        "type": "quantitative",
        "format": ".2%"
      },
      {
        "field": "maturity",
        "type": "nominal"
      },
      {
        "field": "years",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "principal",
        "type": "quantitative",
        "format": ".0f"
      },
      {
        "field": "treasury_yield",
        "type": "quantitative",
        "format": ".3%"
      },
      {
        "field": "treasury_extrapolated",
        "type": "nominal"
      },
      {
        "field": "cds_spread_bp",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "spread_extrapolated",
        "type": "nominal"
      },
      {
        "field": "model_yield",
        "type": "quantitative",
        "format": ".3%"
      },
      {
        "field": "model_price",
        "type": "quantitative",
        "format": ".3f"
      },
      {
        "field": "accrued_interest",
        "type": "quantitative",
        "format": ".3f"
      },
      {
        "field": "modified_duration",
        "type": "quantitative",
        "format": ".3f"
      },
      {
        "field": "dv01_per_100",
        "type": "quantitative",
        "format": ".4f"
      },
      {
        "field": "dv01_usd",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "cumulative_pd",
        "type": "quantitative",
        "format": ".3%"
      },
      {
        "field": "expected_loss_per_100",
        "type": "quantitative",
        "format": ".3f"
      },
      {
        "field": "expected_loss_usd",
        "type": "quantitative",
        "format": ".2f"
      }
    ]
  }
}
