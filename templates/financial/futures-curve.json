{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "futures-curve",
    "version": "1.0.0",
    "doc": "Futures term structure from fut.term_structure: contract price or basis by years to expiry, coloured by curve shape and roll direction.",
    "example": "examples/futures-curve.data.json",
    "slots": {
      "data": {"shape": "invest/futures-curve", "required": true, "doc": "rows from fut.term_structure; one row per contract, pair or spot reference"},
      "title": {"type": "string", "default": ""},
      "description": {"type": "string", "default": "Futures prices and annualized roll by expiry."},
      "measure": {"type": "string", "enum": ["price", "basis"], "default": "price", "doc": "height to draw"}
    }
  },
  "title": {"x-eas:slot": "title"},
  "description": {"x-eas:slot": "description"},
  "width": "container",
  "height": 220,
  "data": {"name": "data"},
  "transform": [{"filter": "datum.kind == 'contract'"}],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {"field": "years", "type": "quantitative", "title": "years to expiry"},
    "y": {"field": {"x-eas:slot": "measure"}, "type": "quantitative", "title": "price / basis"},
    "color": {"field": "roll_sign", "type": "nominal", "title": "roll"},
    "tooltip": [
      {"field": "symbol", "type": "nominal"},
      {"field": "expiry", "type": "nominal"},
      {"field": "bid", "type": "quantitative"},
      {"field": "ask", "type": "quantitative"},
      {"field": "mark", "type": "quantitative"},
      {"field": "oi", "type": "quantitative", "title": "open interest"},
      {"field": "volume", "type": "quantitative"},
      {"field": "basis", "type": "quantitative"},
      {"field": "carry", "type": "quantitative"},
      {"field": "implied_yield", "type": "quantitative"},
      {"field": "roll_to_next", "type": "quantitative"}
    ]
  }
}
